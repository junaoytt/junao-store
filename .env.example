# Copie para .env.local se for rodar na sua máquina com "vercel dev".
# Na Vercel, cadastre estes mesmos nomes em Settings > Environment Variables.
#
# Onde achar as chaves do Supabase: painel do Supabase > Project Settings > API Keys

# Endereço do projeto (Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave pública. Pode aparecer no navegador — as regras do banco (RLS)
# é que protegem os dados.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de administrador. NUNCA coloque no HTML nem suba pro GitHub.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Conta principal do dono. O e-mail abaixo já é o padrão do projeto.
OWNER_EMAIL=junaoyt@gmail.com
OWNER_NAME=JunãoYT

# IMPORTANTE: coloque aqui, e SOMENTE aqui, a senha principal do dono.
# Não escreva a senha no index.html, no GitHub nem em arquivos públicos.
OWNER_PASSWORD=COLOQUE_A_SENHA_DO_DONO_AQUI
