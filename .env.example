# Copie para .env.local se for rodar na sua máquina com "vercel dev".
# Na Vercel, cadastre estes mesmos nomes em Settings > Environment Variables.
#
# Onde achar: painel do Supabase > Project Settings > API Keys

# Endereço do projeto (Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave pública. Pode aparecer no navegador — as regras do banco (RLS)
# é que protegem os dados.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de administrador. NUNCA coloque no HTML nem suba pro GitHub.
# Só o /api/colaborador usa, e ela fica no servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
